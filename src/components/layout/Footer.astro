---
import NewsletterSignup from '@/components/shared/NewsletterSignup.tsx';
import Container from '@/components/layout/Container.astro';
import Grid from '@/components/layout/Grid.astro';
import Col from '@/components/layout/Col.astro';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <Grid rowGap="var(--space-5)">
      <!-- Index — one column: site pages + the feed. A separate "Connect"
           column holding only RSS read as an empty promise; social links
           join this list when real profile URLs exist. -->
      <Col span={{ md: 6, lg: 10 }}>
        <h2 class="site-footer__section-title">Index</h2>
        <ul class="site-footer__links">
          <li><a href="/" class="site-footer__link">Home</a></li>
          <li><a href="/articles/" class="site-footer__link">Articles</a></li>
          <li><a href="/about/" class="site-footer__link">About</a></li>
          <li><a href="/rss.xml" class="site-footer__link">RSS Feed</a></li>
        </ul>
      </Col>

      <!-- Newsletter -->
      <Col span={{ md: 6, lg: 8 }}>
        <NewsletterSignup
          client:visible
          variant="section"
          headline="Stay current"
          subhead="Weekly insights on emergency radiology. Educational depth, clinical utility, no filler."
        />
      </Col>
    </Grid>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {currentYear} Michael Hood, MD &middot; Level One Radiology. All rights reserved.
      </p>
      <nav class="site-footer__legal" aria-label="Legal">
        <a href="/disclaimer/" class="site-footer__legal-link">Not medical advice</a>
        <a href="/privacy/" class="site-footer__legal-link">Privacy</a>
        <a href="/terms/" class="site-footer__legal-link">Terms</a>
      </nav>
      <div class="site-footer__marks">
        <!-- Registration mark + data plate -->
        <svg class="registration-mark" width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
          <circle cx="4" cy="4" r="3" fill="none" stroke="currentColor" stroke-width="0.5"/>
          <line x1="4" y1="0" x2="4" y2="8" stroke="currentColor" stroke-width="0.5"/>
          <line x1="0" y1="4" x2="8" y2="4" stroke="currentColor" stroke-width="0.5"/>
        </svg>
        <span class="site-footer__plate">Est. 2026 · Boston, Mass.</span>
        <svg class="registration-mark" width="8" height="8" viewBox="0 0 8 8" aria-hidden="true">
          <circle cx="4" cy="4" r="3" fill="none" stroke="currentColor" stroke-width="0.5"/>
          <line x1="4" y1="0" x2="4" y2="8" stroke="currentColor" stroke-width="0.5"/>
          <line x1="0" y1="4" x2="8" y2="4" stroke="currentColor" stroke-width="0.5"/>
        </svg>
      </div>
    </div>
  </Container>
</footer>
