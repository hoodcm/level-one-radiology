---
import Layout from '@/layouts/Layout.astro';
import Container from '@/components/layout/Container.astro';

// NOTE (pre-launch facts this page asserts):
// - Hosting/analytics language assumes the Cloudflare go-live
//   (docs/plans/hosting-migration-cloudflare.md). Written for launch state.
// - privacy@leveloneradiology.com needs a forwarder (Cloudflare Email Routing,
//   created during the migration). PLACEHOLDER until that exists.
const description =
  'Privacy policy for leveloneradiology.com: what we collect, how it is used, and your choices.';
---

<Layout title="Privacy | Level One Radiology" description={description}>
  <section class="page">
    <Container width="reading">
      <header class="page-header">
        <p class="type-ui">Privacy</p>
        <h1 class="page-header__title">Privacy Policy</h1>
      </header>
      <div class="prose">
        <p class="lead">
          This Privacy Policy describes what information Level One Radiology ("we," "us")
          collects when you use leveloneradiology.com, how it is used, and the choices
          available to you.
        </p>

        <h2>Information we collect</h2>
        <p>
          The site can be read without an account and without providing any personal
          information. The only personal information we collect is your email address, and
          only if you choose to subscribe to the newsletter.
        </p>

        <h2>Newsletter</h2>
        <p>
          Newsletter subscriptions are processed and stored by
          <a href="https://buttondown.com">Buttondown</a>, our email service provider. Your
          email address is used solely to deliver the newsletter. Every message includes an
          unsubscribe link, and unsubscribing takes effect immediately. To have your address
          permanently deleted from the list, contact us at the address below.
        </p>

        <h2>Analytics</h2>
        <p>
          We use Cloudflare Web Analytics to measure site traffic. It is cookieless and
          reports aggregate information only, such as page views and approximate geographic
          region. It does not identify individual visitors, track you across other websites,
          or build advertising profiles. This site carries no advertising and no ad tracking.
        </p>

        <h2>Cookies</h2>
        <p>This site does not set cookies.</p>

        <h2>Hosting</h2>
        <p>
          The site is hosted by Cloudflare, which maintains standard, short-lived operational
          logs (including IP addresses) for the purpose of operating and securing the
          service.
        </p>

        <h2>Third-party service providers</h2>
        <p>
          Two service providers process data on our behalf: Buttondown (newsletter delivery)
          and Cloudflare (hosting and analytics). We do not sell personal information, and we
          do not share it for marketing purposes.
        </p>

        <h2>Your rights</h2>
        <p>
          You may unsubscribe from the newsletter at any time. You may also request access
          to, correction of, or deletion of the personal information we hold about you.
          Residents of certain jurisdictions, including the European Union, the United
          Kingdom, and California, have these rights under applicable law; we honor the same
          requests from all readers. To exercise any of these rights, contact
          <a href="mailto:privacy@leveloneradiology.com">privacy@leveloneradiology.com</a>.
        </p>

        <h2>Changes to this policy</h2>
        <p>
          If our data practices change, this page will be updated before the change takes
          effect, and the date below will be revised.
        </p>

        <p><em>Last updated August 8, 2026.</em></p>
      </div>
    </Container>
  </section>
</Layout>
